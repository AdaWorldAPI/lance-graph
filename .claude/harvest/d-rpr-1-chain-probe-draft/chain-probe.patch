+//! Composition probe: a question whose answer leaves the focus names the
+//! identities it still needs, those identities are brought into the frame the
+//! question was asked on, and the next question starts from that frame.
+//!
+//! STATUS: PROBE. No new store, executor, opcode or type of relationship: this
+//! module only calls what [`crate::rmap`] already has, in an order.
+//!
+//! - The question is [`Csr::reach`] over a prepared frame.
+//! - Its escape set ([`crate::rmap::ScopedReach::escaped`]) is what the answer still needs.
+//! - [`rebind`] brings those identities in, keeping every edge between slots
+//!   that did not change, and the question is asked again, until nothing
+//!   escapes. Only then is the answer global ([`crate::rmap::ScopedReach::global`]).
+//! - A later question passes an earlier answer as its seeds, over another
+//!   predicate of the same prepared frame.
+//!
+//! Slots are evicted only if they hold no identity the chain still needs
+//! (`keep`); if the needed identities do not fit, the question is refused,
+//! never answered from an incomplete focus. Address translation happens only
+//! inside [`rebind`] and [`Csr::prepare`], in preparation, never in a fold.
+//!
+//! Semantics are Boolean reachability, as in [`crate::rmap`]: no bags, no
+//! path counts.
+
+use std::collections::BTreeSet;
+
+use crate::rmap::{Csr, Focus, Refusal, SlotSet, SortedRun, Tile, Witness, rebind, slot_set};
+
+/// Why a chain step did not answer.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ChainRefusal {
+    /// The frame was built against another facts, seal or scope.
+    Stale(Refusal),
+    /// The identities the answer needs do not fit beside the ones it must keep.
+    FocusExhausted { needed: usize, free: usize },
+}
+
+/// How a focus change reaches the prepared operands.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Rebuild {
+    /// [`rebind`]: unchanged slots keep their edges.
+    Incremental,
+    /// [`Csr::prepare`] and [`Tile::from_csr`] from scratch.
+    Full,
+}
+
+/// A focus and the operands prepared for it, for every predicate the chain uses.
+pub struct Frame {
+    pub focus: Focus,
+    pub csr: Csr,
+    pub tile: Tile,
+    pub preds: Vec<u32>,
+}
+
+impl Frame {
+    pub fn prepare(run: &SortedRun<'_>, focus: Focus, preds: &[u32], current: &Witness) -> Frame {
+        let csr = Csr::prepare(run, &focus, preds, at(current, &focus));
+        let tile = Tile::from_csr(&csr);
+        Frame {
+            focus,
+            csr,
+            tile,
+            preds: preds.to_vec(),
+        }
+    }
+
+    /// The slots of the given identities. `None` if one is not in the focus.
+    pub fn slots(&self, ids: &BTreeSet<u32>) -> Option<SlotSet> {
+        let mut out = Vec::with_capacity(ids.len());
+        for &g in ids {
+            out.push(self.focus.slot_of(g)?);
+        }
+        Some(slot_set(out))
+    }
+
+    /// Bring `ids` into the focus, evicting slots whose identity is not in
+    /// `keep`. Returns how many slots changed.
+    pub fn admit(
+        &mut self,
+        run: &SortedRun<'_>,
+        current: &Witness,
+        keep: &BTreeSet<u32>,
+        ids: &BTreeSet<u32>,
+        how: Rebuild,
+    ) -> Result<usize, ChainRefusal> {
+        let new: Vec<u32> = ids
+            .iter()
+            .copied()
+            .filter(|g| self.focus.slot_of(*g).is_none())
+            .collect();
+        if new.is_empty() {
+            return Ok(0);
+        }
+        let free: Vec<u8> = (0..self.focus.len())
+            .rev()
+            .map(|s| s as u8)
+            .filter(|&s| !keep.contains(&self.focus.id(s)) && !ids.contains(&self.focus.id(s)))
+            .collect();
+        if free.len() < new.len() {
+            return Err(ChainRefusal::FocusExhausted {
+                needed: new.len(),
+                free: free.len(),
+            });
+        }
+        let changes: Vec<(u8, u32)> = free.into_iter().zip(new.iter().copied()).collect();
+        let focus = self.focus.replace(&changes);
+        let w = at(current, &focus);
+        let (csr, tile) = match how {
+            Rebuild::Incremental => rebind(run, &self.focus, &focus, &self.csr, w),
+            Rebuild::Full => {
+                let csr = Csr::prepare(run, &focus, &self.preds, w);
+                let tile = Tile::from_csr(&csr);
+                (csr, tile)
+            }
+        };
+        self.focus = focus;
+        self.csr = csr;
+        self.tile = tile;
+        Ok(changes.len())
+    }
+}
+
+/// The caller's witness, read at this focus's generation.
+fn at(current: &Witness, focus: &Focus) -> Witness {
+    Witness {
+        focus: focus.generation,
+        ..*current
+    }
+}
+
+/// One answer and what it took.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Answer {
+    /// Global identities reached within the hop budget, seeds included.
+    pub reached: BTreeSet<u32>,
+    /// Slots that changed before each re-ask (0 for an answer from the frame as it was).
+    pub admitted: Vec<usize>,
+}
+
+/// Reachability from `seeds` over `preds` within `hops`, asked on `frame` and
+/// re-asked after each admission until nothing escapes. `keep` holds the
+/// identities earlier answers still need; this answer's are added to it.
+#[expect(clippy::too_many_arguments)]
+pub fn ask(
+    frame: &mut Frame,
+    run: &SortedRun<'_>,
+    current: &Witness,
+    preds: &[u32],
+    seeds: &BTreeSet<u32>,
+    hops: usize,
+    keep: &mut BTreeSet<u32>,
+    how: Rebuild,
+) -> Result<Answer, ChainRefusal> {
+    keep.extend(seeds.iter().copied());
+    let mut admitted = vec![frame.admit(run, current, keep, seeds, how)?];
+    loop {
+        let seed_slots = frame.slots(seeds).expect("seeds were admitted");
+        let r = frame
+            .csr
+            .reach(&at(current, &frame.focus), preds, &seed_slots, hops)
+            .map_err(ChainRefusal::Stale)?;
+        let reached: BTreeSet<u32> = crate::rmap::slots_of(&r.reached)
+            .into_iter()
+            .map(|s| frame.focus.id(s))
+            .collect();
+        keep.extend(reached.iter().copied());
+        if r.global().is_ok() {
+            return Ok(Answer { reached, admitted });
+        }
+        admitted.push(frame.admit(run, current, keep, &r.escaped, how)?);
+    }
+}
