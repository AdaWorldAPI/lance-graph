+//! The composition probe (`chain`) against a global oracle that uses no index,
+//! no focus and no prepared operand: a breadth-first scan over the facts.
+
+use std::collections::BTreeSet;
+
+use mork_pathmap_probe::chain::{Answer, ChainRefusal, Frame, Rebuild, ask};
+use mork_pathmap_probe::rmap::*;
+
+const PREDS: [u32; 3] = [0, 1, 2];
+
+/// Global reachability from `seeds` over `preds` within `hops`, by scanning.
+fn oracle(facts: &[Fact], preds: &[u32], seeds: &BTreeSet<u32>, hops: usize) -> BTreeSet<u32> {
+    let mut reached = seeds.clone();
+    let mut frontier = seeds.clone();
+    for _ in 0..hops {
+        let next: BTreeSet<u32> = facts
+            .iter()
+            .filter(|f| frontier.contains(&f[0]) && preds.contains(&f[1]))
+            .map(|f| f[2])
+            .filter(|o| !reached.contains(o))
+            .collect();
+        if next.is_empty() {
+            break;
+        }
+        reached.extend(next.iter().copied());
+        frontier = next;
+    }
+    reached
+}
+
+fn facts() -> Vec<Fact> {
+    graph(65_536, 3, 2, 512, 0.9, 0x5EED)
+}
+
+fn cur() -> Witness {
+    Witness {
+        facts: 1,
+        seal: 1,
+        focus: 0,
+        scope: 7,
+    }
+}
+
+const SEED: u32 = 17;
+
+/// Three questions, each over its own predicate, each seeded with the
+/// previous answer: what the first reaches, where those lead under the second
+/// predicate, and under the third.
+struct Chain {
+    answers: Vec<Answer>,
+    frame: Frame,
+    initial_rows: BTreeSet<u32>,
+}
+
+fn run_chain(facts: &[Fact], how: Rebuild) -> Chain {
+    let run = SortedRun::build(facts, false, 1);
+    // The first focus is what a breadth-first discovery over all predicates
+    // finds first, so a question over one predicate is not shaped to fit it.
+    let focus = discover(&run, &[SEED], &PREDS, SLOTS);
+    let mut frame = Frame::prepare(&run, focus, &PREDS, &cur());
+    let initial_rows = frame.csr.edge_set().into_iter().map(|e| e.3).collect();
+    let mut keep = BTreeSet::new();
+    let mut seeds = BTreeSet::from([SEED]);
+    let mut answers = Vec::new();
+    for (p, hops) in [(0u32, 3usize), (1, 1), (2, 1)] {
+        let a = ask(&mut frame, &run, &cur(), &[p], &seeds, hops, &mut keep, how).unwrap();
+        seeds = a.reached.clone();
+        answers.push(a);
+    }
+    Chain {
+        answers,
+        frame,
+        initial_rows,
+    }
+}
+
+const QUESTIONS: [(u32, usize); 3] = [(0, 3), (1, 1), (2, 1)];
+
+#[test]
+fn every_step_of_the_chain_equals_the_global_oracle() {
+    let facts = facts();
+    let c = run_chain(&facts, Rebuild::Incremental);
+    let mut seeds = BTreeSet::from([SEED]);
+    for (i, ((p, hops), a)) in QUESTIONS.iter().zip(&c.answers).enumerate() {
+        assert_eq!(a.reached, oracle(&facts, &[*p], &seeds, *hops), "step {i}");
+        seeds = a.reached.clone();
+    }
+    // Anti-vacuity: the first focus did not hold the first answer, so a step
+    // had to bring identities in; and every answer is more than its seeds.
+    let total: usize = c.answers.iter().flat_map(|a| &a.admitted).sum();
+    assert!(
+        total > 0,
+        "no step admitted anything: the fixture tests nothing"
+    );
+    assert!(
+        c.answers[0].admitted.len() > 1,
+        "the first question must have been re-asked"
+    );
+    for a in &c.answers {
+        assert!(a.reached.len() > 1);
+    }
+}
+
+/// Each answer still holds on the frame the whole chain left: a later step
+/// never evicts what an earlier answer needs, so re-asking the first question
+/// at the end admits nothing and gives the same answer.
+#[test]
+fn an_earlier_answer_survives_the_later_steps() {
+    let facts = facts();
+    let mut c = run_chain(&facts, Rebuild::Incremental);
+    let run = SortedRun::build(&facts, false, 1);
+    let mut keep = BTreeSet::new();
+    let again = ask(
+        &mut c.frame,
+        &run,
+        &cur(),
+        &[0],
+        &BTreeSet::from([SEED]),
+        3,
+        &mut keep,
+        Rebuild::Incremental,
+    )
+    .unwrap();
+    assert_eq!(again.reached, c.answers[0].reached);
+    assert_eq!(again.admitted, vec![0], "nothing to admit, asked once");
+}
+
+/// The incremental frame equals a frame prepared from scratch at every step,
+/// and it keeps canonical rows from the first preparation (reuse is real,
+/// not a full rebuild under another name).
+#[test]
+fn incremental_frames_equal_full_preparation_and_reuse_rows() {
+    let facts = facts();
+    let inc = run_chain(&facts, Rebuild::Incremental);
+    let full = run_chain(&facts, Rebuild::Full);
+    assert_eq!(inc.answers, full.answers);
+    assert_eq!(inc.frame.focus.ids(), full.frame.focus.ids());
+    assert_eq!(inc.frame.csr.edge_set(), full.frame.csr.edge_set());
+    assert_eq!(inc.frame.csr.escape_set(), full.frame.csr.escape_set());
+    for &p in &PREDS {
+        assert_eq!(inc.frame.tile.plane(p), full.frame.tile.plane(p));
+    }
+    let rows: BTreeSet<u32> = inc.frame.csr.edge_set().into_iter().map(|e| e.3).collect();
+    let reused = rows.intersection(&inc.initial_rows).count();
+    let resolved = rows.difference(&inc.initial_rows).count();
+    assert!(
+        reused > 0 && resolved > 0,
+        "reused {reused}, resolved {resolved}"
+    );
+}
+
+/// A frame from before a change of the facts is refused, not answered.
+#[test]
+fn a_changed_world_refuses_the_frame() {
+    let facts = facts();
+    let mut c = run_chain(&facts, Rebuild::Incremental);
+    let run = SortedRun::build(&facts, false, 1);
+    let changed = Witness { facts: 2, ..cur() };
+    let r = ask(
+        &mut c.frame,
+        &run,
+        &changed,
+        &[0],
+        &BTreeSet::from([SEED]),
+        3,
+        &mut BTreeSet::new(),
+        Rebuild::Incremental,
+    );
+    assert_eq!(r, Err(ChainRefusal::Stale(Refusal::FactsChanged)));
+}
+
+/// The needed identities must fit beside the kept ones; otherwise the question
+/// is refused. Silence twin: one evictable slot is enough for the same chain.
+#[test]
+fn a_focus_too_small_for_the_answer_is_refused() {
+    // 0 -> 1 -> 2: from 0, two hops need {0, 1, 2}.
+    let facts: Vec<Fact> = vec![[0, 0, 1], [1, 0, 2]];
+    let run = SortedRun::build(&facts, false, 1);
+    let mut frame = Frame::prepare(&run, Focus::bind(&[0, 1], 1), &[0], &cur());
+    let r = ask(
+        &mut frame,
+        &run,
+        &cur(),
+        &[0],
+        &BTreeSet::from([0]),
+        2,
+        &mut BTreeSet::new(),
+        Rebuild::Incremental,
+    );
+    assert_eq!(r, Err(ChainRefusal::FocusExhausted { needed: 1, free: 0 }));
+    let mut frame = Frame::prepare(&run, Focus::bind(&[0, 1, 50], 1), &[0], &cur());
+    let a = ask(
+        &mut frame,
+        &run,
+        &cur(),
+        &[0],
+        &BTreeSet::from([0]),
+        2,
+        &mut BTreeSet::new(),
+        Rebuild::Incremental,
+    )
+    .unwrap();
+    assert_eq!(a.reached, BTreeSet::from([0, 1, 2]));
+    assert_eq!(a.admitted, vec![0, 1]);
+}
+
+/// 64 thoughts over the frame the chain produced: each retracts the edges
+/// out of one slot the first answer reached. Each thought's answer equals the
+/// oracle over its edited facts (inside the focus), and the shared tile is
+/// not changed by any of them.
+#[test]
+fn thoughts_run_over_the_frame_the_chain_produced() {
+    let facts = facts();
+    let c = run_chain(&facts, Rebuild::Incremental);
+    let f = &c.frame;
+    let w = Witness {
+        focus: f.focus.generation,
+        ..cur()
+    };
+    let seeds = slot_set([f.focus.slot_of(SEED).unwrap()]);
+    let mut ex = TileExec::new();
+    let base = ex
+        .reach(&f.tile, &f.csr, &w, None, None, &[0], &seeds, 3)
+        .unwrap();
+    let reached: Vec<u8> = slots_of(&base.reached);
+    let inf: BTreeSet<u32> = f.focus.ids().iter().copied().collect();
+    let mut changed = 0;
+    for t in 0..64u64 {
+        let victim = reached[t as usize % reached.len()];
+        let del: Vec<(u8, u8)> = f
+            .csr
+            .edge_set()
+            .into_iter()
+            .filter(|e| e.0 == 0 && e.1 == victim)
+            .map(|e| (victim, e.2))
+            .collect();
+        let delta = ThoughtDelta::new(t, 0, &[], &del);
+        let got = ex
+            .reach(&f.tile, &f.csr, &w, Some(&delta), Some(t), &[0], &seeds, 3)
+            .unwrap();
+        let g = f.focus.id(victim);
+        let edited: Vec<Fact> = facts
+            .iter()
+            .copied()
+            .filter(|x| !(x[0] == g && x[1] == 0 && inf.contains(&x[2])))
+            .filter(|x| inf.contains(&x[0]) && inf.contains(&x[2]))
+            .collect();
+        let want = oracle(&edited, &[0], &BTreeSet::from([SEED]), 3);
+        let got_ids: BTreeSet<u32> = slots_of(&got.reached)
+            .into_iter()
+            .map(|s| f.focus.id(s))
+            .collect();
+        assert_eq!(got_ids, want, "thought {t}");
+        changed += usize::from(got.reached != base.reached);
+        assert_eq!(
+            ex.reach(
+                &f.tile,
+                &f.csr,
+                &w,
+                Some(&delta),
+                Some(t + 1),
+                &[0],
+                &seeds,
+                3
+            )
+            .err(),
+            Some(Refusal::ThoughtMismatch)
+        );
+    }
+    assert!(
+        changed > 0,
+        "some retraction must change its thought's answer"
+    );
+    let again = ex
+        .reach(&f.tile, &f.csr, &w, None, None, &[0], &seeds, 3)
+        .unwrap();
+    assert_eq!(again.reached, base.reached, "the shared tile is unchanged");
+}
