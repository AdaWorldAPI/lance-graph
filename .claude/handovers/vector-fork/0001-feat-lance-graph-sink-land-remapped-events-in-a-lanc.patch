+//! Lands events normalized by a VRL `remap` in a lance-graph
+//! [`VectorRoute`], in process, without JSON.
+//!
+//! The remap sets `.lg.event_id` (and `.lg.schema_rev`) and leaves the
+//! program's outputs as top-level scalars. [`EventView::of`] reads one such
+//! value; [`land`] hands a batch to the route, which admits it all or
+//! nothing. This is the same admission the route's NDJSON front end runs for
+//! Vector's http sink, minus the encode and the parse.
+//!
+//! Numbers: an `Integer` lands as an integer. A `Float` is an `f64` inside
+//! Vector already, so it lands as its shortest round-trip text; a value
+//! that must stay an exact decimal is kept as a string by the remap.
+
+use lance_graph_vector::{Ack, Cell, Event, VectorRoute};
+use vrl::value::Value;
+
+/// Why a value cannot be handed to the route. Each refuses the whole batch,
+/// as the route's own refusals do.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum SinkRefusal {
+    /// The event is not an object.
+    NotAnObject { index: usize },
+    /// `.lg.event_id` is missing or not a string (bytes or UTF-8 string).
+    MissingEventId { index: usize },
+    /// A top-level field (or `.lg.schema_rev`) is an object, array or regex.
+    NotScalar { index: usize, field: String },
+    /// A string is not UTF-8.
+    NotText { index: usize, field: String },
+}
+
+/// One event's fields, rendered where a VRL value has no borrowed text.
+#[derive(Debug)]
+pub struct EventView<'a> {
+    event_id: &'a str,
+    schema_rev: Option<String>,
+    fields: Vec<(&'a str, Slot<'a>)>,
+}
+
+#[derive(Debug)]
+enum Slot<'a> {
+    Absent,
+    Int(i64),
+    Bool(bool),
+    Text(&'a str),
+    Rendered(String),
+    Number(String),
+}
+
+fn text<'a>(index: usize, field: &str, b: &'a [u8]) -> Result<&'a str, SinkRefusal> {
+    std::str::from_utf8(b).map_err(|_| SinkRefusal::NotText {
+        index,
+        field: field.to_owned(),
+    })
+}
+
+fn slot<'a>(index: usize, field: &str, v: &'a Value) -> Result<Slot<'a>, SinkRefusal> {
+    Ok(match v {
+        Value::Null => Slot::Absent,
+        Value::Integer(i) => Slot::Int(*i),
+        Value::Boolean(b) => Slot::Bool(*b),
+        Value::Float(f) => Slot::Number(f.into_inner().to_string()),
+        Value::Bytes(b) => Slot::Text(text(index, field, b)?),
+        Value::String(s) => Slot::Text(s),
+        Value::Timestamp(t) => {
+            Slot::Rendered(t.to_rfc3339_opts(chrono::SecondsFormat::AutoSi, true))
+        }
+        Value::Object(_) | Value::Array(_) | Value::Regex(_) => {
+            return Err(SinkRefusal::NotScalar {
+                index,
+                field: field.to_owned(),
+            });
+        }
+    })
+}
+
+impl<'a> EventView<'a> {
+    /// Read one remapped event. `index` numbers it within the batch.
+    pub fn of(index: usize, value: &'a Value) -> Result<Self, SinkRefusal> {
+        let Value::Object(map) = value else {
+            return Err(SinkRefusal::NotAnObject { index });
+        };
+        let lg = match map.get("lg") {
+            Some(Value::Object(lg)) => lg,
+            _ => return Err(SinkRefusal::MissingEventId { index }),
+        };
+        let event_id = match lg.get("event_id") {
+            Some(Value::Bytes(b)) => text(index, "lg.event_id", b)?,
+            Some(Value::String(s)) => s,
+            _ => return Err(SinkRefusal::MissingEventId { index }),
+        };
+        let schema_rev = match lg.get("schema_rev") {
+            None | Some(Value::Null) => None,
+            Some(v) => match slot(index, "lg.schema_rev", v)? {
+                Slot::Text(s) => Some(s.to_owned()),
+                Slot::Int(i) => Some(i.to_string()),
+                Slot::Number(s) | Slot::Rendered(s) => Some(s),
+                Slot::Bool(b) => Some(b.to_string()),
+                Slot::Absent => None,
+            },
+        };
+        let mut fields = Vec::with_capacity(map.len().saturating_sub(1));
+        for (k, v) in map.iter() {
+            let k: &str = k.as_str();
+            if k == "lg" {
+                continue;
+            }
+            fields.push((k, slot(index, k, v)?));
+        }
+        Ok(Self {
+            event_id,
+            schema_rev,
+            fields,
+        })
+    }
+
+    /// The route's typed event, borrowing this view.
+    pub fn event(&self) -> Event<'_> {
+        Event {
+            event_id: self.event_id,
+            schema_rev: self.schema_rev.as_deref(),
+            fields: self
+                .fields
+                .iter()
+                .map(|(k, s)| {
+                    let c = match s {
+                        Slot::Absent => Cell::Absent,
+                        Slot::Int(i) => Cell::Int(*i),
+                        Slot::Bool(b) => Cell::Bool(*b),
+                        Slot::Text(t) => Cell::Text(t),
+                        Slot::Rendered(t) => Cell::Text(t),
+                        Slot::Number(t) => Cell::Number(t),
+                    };
+                    (*k, c)
+                })
+                .collect(),
+        }
+    }
+}
+
+/// Hand a batch of remapped events to the route. A value the route cannot
+/// take refuses the batch before anything reaches it.
+pub fn land(route: &mut VectorRoute, batch: &[Value]) -> Result<Ack, SinkRefusal> {
+    let views = batch
+        .iter()
+        .enumerate()
+        .map(|(i, v)| EventView::of(i + 1, v))
+        .collect::<Result<Vec<_>, _>>()?;
+    let events: Vec<Event<'_>> = views.iter().map(EventView::event).collect();
+    Ok(route.receive_events(&events))
+}
