@@ -0,0 +1,133 @@
+//! The in-Vector path lands as the NDJSON path does.
+
+use std::sync::Arc;
+
+use lance_graph_contract::pg_row::{AbsentAs, LaneEncoding, PgType};
+use lance_graph_intake::{ColumnConfig, ShapeConfig, SourceProfile};
+use lance_graph_sink::{SinkRefusal, land};
+use lance_graph_vector::{Ack, EVENT_ID, SEQ, VectorRoute};
+use vrl::value;
+
+fn declared(ty: PgType, encoding: LaneEncoding) -> ColumnConfig {
+    ColumnConfig {
+        ty: Some(ty),
+        encoding: Some(encoding),
+        absent: Some(AbsentAs::Null),
+    }
+}
+
+/// The landing profile `output_profile` declares for a remap that writes
+/// `.host` (text) and `.amt` (int).
+fn profile() -> Arc<SourceProfile> {
+    let mut config = ShapeConfig {
+        key: Some(SEQ.0.to_owned()),
+        ..ShapeConfig::default()
+    };
+    config.columns.insert(
+        "host".into(),
+        declared(PgType::Text, LaneEncoding::TextCode),
+    );
+    config
+        .columns
+        .insert("amt".into(), declared(PgType::Int4, LaneEncoding::Signed));
+    config.columns.insert(
+        EVENT_ID.0.into(),
+        declared(PgType::Text, LaneEncoding::TextCode),
+    );
+    config
+        .columns
+        .insert(SEQ.0.into(), declared(PgType::Int4, LaneEncoding::Signed));
+    SourceProfile::new(
+        0x2B0A_0002,
+        &[
+            ("amt", "dd:host/cpu_milli"),
+            ("host", "dd:host/region"),
+            EVENT_ID,
+            SEQ,
+        ],
+        config,
+    )
+    .unwrap()
+}
+
+fn route() -> VectorRoute {
+    VectorRoute::new("tenant_a", &profile(), "1").unwrap()
+}
+
+const NDJSON: &str = r#"{"lg":{"event_id":"e1","schema_rev":"1"},"host":"north","amt":12}
+{"lg":{"event_id":"e3","schema_rev":"1"},"host":"north","amt":null}
+{"lg":{"event_id":"e4","schema_rev":"1"},"host":"east","amt":40}
+"#;
+
+fn batch() -> Vec<vrl::value::Value> {
+    vec![
+        value!({"lg": {"event_id": "e1", "schema_rev": "1"}, "host": "north", "amt": 12}),
+        value!({"lg": {"event_id": "e3", "schema_rev": "1"}, "host": "north", "amt": null}),
+        value!({"lg": {"event_id": "e4", "schema_rev": "1"}, "host": "east", "amt": 40}),
+    ]
+}
+
+/// FAILS IF: remapped VRL values land other than the same events as NDJSON,
+/// or a retried batch appends again.
+#[test]
+fn vrl_values_land_as_ndjson_does() {
+    let mut sink = route();
+    let mut http = route();
+    let committed = Ack::Committed {
+        appended: 3,
+        duplicates: 0,
+    };
+    assert_eq!(land(&mut sink, &batch()), Ok(committed.clone()));
+    assert_eq!(http.receive(NDJSON), committed);
+    assert_eq!(sink.table().len(), http.table().len());
+    for code in 1..=2 {
+        assert_eq!(
+            sink.table().code_key("host", code),
+            http.table().code_key("host", code)
+        );
+    }
+    assert_eq!(
+        land(&mut sink, &batch()),
+        Ok(Ack::Committed {
+            appended: 0,
+            duplicates: 3
+        })
+    );
+}
+
+/// FAILS IF: a nested field, a missing event id or a non-object reaches the
+/// route instead of refusing the batch, or a refused batch appends anything.
+#[test]
+fn a_value_the_route_cannot_take_refuses_the_batch() {
+    let mut sink = route();
+    let nested = vec![
+        value!({"lg": {"event_id": "e1", "schema_rev": "1"}, "host": "north", "amt": 1}),
+        value!({"lg": {"event_id": "e2", "schema_rev": "1"}, "host": {"name": "x"}}),
+    ];
+    assert_eq!(
+        land(&mut sink, &nested),
+        Err(SinkRefusal::NotScalar {
+            index: 2,
+            field: "host".into()
+        })
+    );
+    assert_eq!(
+        land(&mut sink, &[value!({"host": "north"})]),
+        Err(SinkRefusal::MissingEventId { index: 1 })
+    );
+    assert_eq!(
+        land(&mut sink, &[value!("north")]),
+        Err(SinkRefusal::NotAnObject { index: 1 })
+    );
+    assert_eq!(sink.table().len(), 0);
+}
+
+/// FAILS IF: a stale schema revision is not passed through to the route's
+/// 400.
+#[test]
+fn the_schema_revision_reaches_the_route() {
+    let mut sink = route();
+    let stale = [value!({"lg": {"event_id": "e1", "schema_rev": "2"}, "host": "north", "amt": 1})];
+    assert_eq!(land(&mut sink, &stale).unwrap().status(), 400);
+    assert_eq!(sink.table().len(), 0);
+}
