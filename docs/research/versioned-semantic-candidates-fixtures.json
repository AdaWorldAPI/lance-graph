  "cases": [
    {
      "id": "C-01",
      "name": "Ring rotations with explicit identity",
      "type": "semantic_equivalence",
      "input": {
        "sentences": [
          "That key opens a door.",
          "That door hides a garden.",
          "That garden shelters a fox.",
          "That fox carries a key."
        ],
        "entry_orders": [
          [
            0,
            1,
            2,
            3
          ],
          [
            1,
            2,
            3,
            0
          ],
          [
            2,
            3,
            0,
            1
          ],
          [
            3,
            0,
            1,
            2
          ]
        ],
        "external_identity_witness": {
          "lhs": "last_sentence.key",
          "rhs": "first_sentence.key",
          "root": "independent_coref_witness_1"
        }
      },
      "expected": {
        "canonical_relation_set_equivalent": true,
        "cycle_closed": true,
        "allow_different_physical_plans": true,
        "preserve_witness": true
      }
    },
    {
      "id": "C-02",
      "name": "No fabricated closure",
      "type": "abstention",
      "input": {
        "sentences": [
          "That key opens a door.",
          "That door hides a garden.",
          "That garden shelters a fox.",
          "That fox carries a key."
        ],
        "entry_orders": [
          [
            0,
            1,
            2,
            3
          ],
          [
            1,
            2,
            3,
            0
          ],
          [
            2,
            3,
            0,
            1
          ],
          [
            3,
            0,
            1,
            2
          ]
        ],
        "external_identity_witness": null
      },
      "expected": {
        "cycle_closed": false,
        "coreference_status": "Unresolved",
        "no_implicit_identity_mint": true
      }
    },
    {
      "id": "C-03",
      "name": "Active passive role normalization",
      "type": "semantic_equivalence",
      "input": {
        "paraphrases": [
          "That key opens a door.",
          "A door is opened by that key."
        ],
        "referents": {
          "key": "k1",
          "door": "d1"
        }
      },
      "expected": {
        "canonical_claim_equivalent": true,
        "canonical_predicate": "opens",
        "agent": "k1",
        "theme": "d1"
      }
    },
    {
      "id": "C-04",
      "name": "Predicate change cannot preserve claim identity",
      "type": "non_equivalence",
      "input": {
        "original": "That fox carries a key.",
        "changed": "That fox destroys a key.",
        "same_explicit_entities": true
      },
      "expected": {
        "canonical_claim_equivalent": false,
        "unlabeled_topology_may_match": true
      }
    },
    {
      "id": "C-05",
      "name": "German neuter pronoun alternatives",
      "type": "candidate_admission",
      "input": {
        "sentence": "Das Kind nahm das Buch, weil es lernen wollte.",
        "surface": "es",
        "grammar_compatible_antecedents": [
          "Kind",
          "Buch"
        ],
        "contextual_semantic_gold": null
      },
      "expected": {
        "distinct_candidate_ids": [
          "corefers(es,Kind)",
          "corefers(es,Buch)"
        ],
        "candidate_count": 2,
        "force_established": false,
        "retain_alternatives": true
      }
    },
    {
      "id": "C-06",
      "name": "Replicated source not independent",
