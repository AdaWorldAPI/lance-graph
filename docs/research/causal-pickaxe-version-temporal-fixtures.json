        "status": "NOT_RUN"
      }
    },
    {
      "id": "CPG-15",
      "title": "Retention and version pin",
      "input": {
        "checkout_ref": [
          "datasetD",
          "main",
          3
        ],
        "cleanup_requested": true
      },
      "expected": {
        "require": "pin prevents cleanup OR explicit retention refusal; no silent reconstructed data",
        "status": "NOT_RUN"
      }
    },
    {
      "id": "CPG-16",
      "title": "Retry after lost acknowledgement",
      "input": {
        "cycle": 9,
