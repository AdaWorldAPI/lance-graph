billable_work_entry::is_billable    key=b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1 schema=00420936c94ff753 reading=1 := V(billable_work_entry).has(billable, true)
billable_work_entry::billable_hours key=b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2 schema=00420936c94ff753 reading=1 := V(billable_work_entry).where(is_billable()).values(duration).sum()
