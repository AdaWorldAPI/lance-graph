# lance-graph — Sapphire Rapids build (server/Railway)
# target-cpu=sapphirerapids: the x86-64-v4 AVX-512 baseline plus VNNI, BF16,
# FP16, VBMI2, BITALG and VPOPCNTDQ (AMX is runtime-detected by ndarray;
# stable rustc does not expose it as a cfg). Railway hosts are Sapphire Rapids,
# Emerald Rapids or newer; all of them carry these features.
#
# ONLY deploy on Sapphire Rapids or newer. On an older host ndarray's startup
# cpu_guard names the missing features and exits before main.
#
# The build stage runs the tests, so they execute on the build host: a build
# that lands on an older host fails here instead of in production.
#
# CPU detection & SIMD dispatch documentation: see Dockerfile.md
# This is the canonical deploy file. Dockerfile builds the broader x86-64-v4
# tier as the fallback when a deploy does not name this one.
#
# Build: docker build -f Dockerfile.avx512 -t lance-graph-avx512 .
# Run:   docker run --rm lance-graph-avx512

FROM debian:bookworm-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates gcc libc6-dev pkg-config libssl-dev \
    protobuf-compiler cmake \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain 1.99.0 --profile minimal \
    && rustc --version | grep -q "1.99.0"

WORKDIR /app

COPY Cargo.toml ./
COPY crates/ crates/

# Compile-time dispatch for Sapphire Rapids, everything inlined
ENV RUSTFLAGS="-C target-cpu=sapphirerapids"

# bgz17 standalone (zero deps, fast check)
RUN cargo build --release --manifest-path crates/bgz17/Cargo.toml 2>&1 \
    && echo "=== BGZ17 AVX-512 BUILD OK ==="

RUN cargo test --release --manifest-path crates/bgz17/Cargo.toml 2>&1 \
    && echo "=== BGZ17 AVX-512 TESTS OK ==="

# Workspace (skip python bindings)
RUN cargo build --release \
    --workspace \
    --exclude lance-graph-python \
    2>&1 && echo "=== WORKSPACE AVX-512 BUILD OK ==="

RUN cargo test --release \
    --workspace \
    --exclude lance-graph-python \
    2>&1 && echo "=== WORKSPACE AVX-512 TESTS OK ==="

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
CMD ["echo", "lance-graph build verified — Rust 1.99.0, target-cpu=sapphirerapids"]
